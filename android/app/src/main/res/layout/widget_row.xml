<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="4dp">

    <ImageView
        android:id="@+id/widget_poster"
        android:layout_width="42dp"
        android:layout_height="62dp"
        android:background="@drawable/widget_poster_bg"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_row_remaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/accent_2"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
            android:id="@+id/widget_expand"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/widget_expand"
            android:padding="6dp"
            android:src="@drawable/widget_expand"
            android:visibility="gone" />

    <ImageView
            android:id="@+id/widget_watch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/mark_watched"
            android:padding="6dp"
            android:src="@drawable/widget_check"
            android:visibility="gone" />
</LinearLayout>
