# Copy to .env and fill in values. Never commit .env.

SECRET_KEY=
DEBUG=1
HOST=0.0.0.0
PORT=8300
PUBLIC_HOST=tvtracker.melamoud.com

# HTTPS cookie flag (keep 1 when using run.py HTTPS; use 0 only with run.py --http)
SESSION_COOKIE_SECURE=1

# Admin bootstrap: your Trakt username(s), comma-separated.
# After the first admin logs in, further env promotions are ignored unless:
ADMIN_TRAKT_USERNAMES=your_trakt_username
ADMIN_ALLOW_ENV_PROMOTE=0

# Trakt API application (https://trakt.tv/oauth/applications)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=https://localhost:8300/auth/callback

# Google Calendar (optional). OAuth client with Calendar API enabled.
# Redirect URI must match exactly (local and production are different).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://localhost:8300/auth/google/callback

# TMDB API key for watch providers (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
STREAMING_REGION=US

# Optional overrides
# DATABASE_URL=sqlite:///D:/dev/TraktTVShowsTracker/instance/trakttv.db

# Background sync defaults (overridden after first start via Admin → Scheduler).
CATALOG_SYNC_INTERVAL_MINUTES=60
ALERTS_INTERVAL_HOURS=6
ALERTS_STARTUP_DELAY_SECONDS=120
# PROVIDER_SYNC_INTERVAL_HOURS is a legacy fallback only.
